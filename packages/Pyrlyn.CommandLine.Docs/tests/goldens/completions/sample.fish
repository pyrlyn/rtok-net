function __sample_path
    set -l tokens (commandline -opc)
    set -e tokens[1]
    set -l cmd ''
    set -l skip 0
    for word in $tokens
        set -l next (string trim -- "$cmd $word")
        if test $skip = 1
            set skip 0
        else if string match -q -- '-*' $word
            contains -- "$cmd|$word" $__sample_values; and set skip 1
        else if contains -- $next $__sample_paths
            set cmd $next
        end
    end
    echo $cmd
end

function __sample_at
    set -l at (__sample_path)
    test "$at" = "$argv[1]"
end

