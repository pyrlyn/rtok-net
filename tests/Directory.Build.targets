<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Rtok.AotTests uses the source-generated xUnit (xunit.v3.aot.mtp-v2) instead. -->
  <ItemGroup Condition="'$(RtokIsTests)' == 'true' and '$(MSBuildProjectName)' != 'Rtok.AotTests'">
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
