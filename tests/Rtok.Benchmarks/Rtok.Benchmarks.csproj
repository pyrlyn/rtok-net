<Project Sdk="Microsoft.NET.Sdk">
  <!-- BenchmarkDotNet micro-benchmarks; run them as tests/README.md says. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RtokSurface>true</RtokSurface>
    <RtokJitOnly>true</RtokJitOnly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rtok.Testing/Rtok.Testing.csproj" />
    <ProjectReference Include="../../src/Rtok.Plugins.Graph/Rtok.Plugins.Graph.csproj" />
    <ProjectReference Include="../../src/Rtok.Store/Rtok.Store.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The graph tests' host over a real store; there is no production host before T15. -->
    <Compile Include="../Rtok.Plugins.Graph.Tests/StoreHost.cs" Link="StoreHost.cs" />
  </ItemGroup>
</Project>
