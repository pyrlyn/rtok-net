import os
import json as j
from collections import OrderedDict, defaultdict as dd
from . import sibling


class Repo:
    """A repository."""

    def __init__(self, root):
        self.root = os.path.abspath(root)

    def files(self):
        return sorted(os.listdir(self.root))


def main(argv):
    repo = Repo(argv[0])
    print(j.dumps(repo.files()))


