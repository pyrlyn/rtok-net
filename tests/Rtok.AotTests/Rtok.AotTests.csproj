<Project Sdk="Microsoft.NET.Sdk">
  <!-- The AOT lane: source-generated xUnit, run only as a published NativeAOT executable.
       Rtok.Smoke publishes and runs it; dotnet test never runs it on the JIT. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.aot.mtp-v2" />
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- Pyrlyn.TreeSitter on NativeAOT: its static library linked in, its fixtures checked
       against the same goldens as its JIT tests. -->
  <ItemGroup>
    <ProjectReference Include="../../packages/Pyrlyn.TreeSitter/src/Pyrlyn.TreeSitter.csproj" />
    <Compile
      Include="../../packages/Pyrlyn.TreeSitter/tests/TagsGolden.cs"
      Link="TreeSitter/TagsGolden.cs"
    />
    <None
      Include="../../packages/Pyrlyn.TreeSitter/tests/fixtures/**"
      Link="tree-sitter-fixtures/%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
  <Import Project="../../packages/Pyrlyn.TreeSitter/src/build/Pyrlyn.TreeSitter.targets" />
  <Import Project="../../src/Rtok.Store/StoreHost.targets" />
</Project>
