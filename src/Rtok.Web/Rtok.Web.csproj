<Project Sdk="Microsoft.NET.Sdk">
  <!-- rtok web (N13): Kestrel serving /health, /ws and the dashboard client, which is published
       before compile and embedded here. -->
  <PropertyGroup>
    <RootNamespace>Rtok.Web</RootNamespace>
    <RtokSurface>true</RtokSurface>
    <RtokClientDir>$(BaseIntermediateOutputPath)client/$(Configuration)/</RtokClientDir>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rtok.Archive/Rtok.Archive.csproj" />
    <ProjectReference Include="../Rtok.Config/Rtok.Config.csproj" />
    <ProjectReference Include="../Rtok.Model/Rtok.Model.csproj" />
    <ProjectReference Include="../Rtok.Web.Contracts/Rtok.Web.Contracts.csproj" />
    <!-- Built first; published and embedded by RtokEmbedClient below, never referenced. -->
    <ProjectReference
      Include="../Rtok.Web.Client/Rtok.Web.Client.csproj"
      ReferenceOutputAssembly="false"
      SkipGetTargetFrameworkProperties="true"
    />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rtok.Web.Tests" />
    <InternalsVisibleTo Include="rtok-fuzz" />
  </ItemGroup>
  <Import Project="ClientEmbed.targets" />
</Project>
