<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rtok</AssemblyName>
    <RootNamespace>Rtok.Cli</RootNamespace>
    <RtokSurface>true</RtokSurface>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="ConsoleAppFramework"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
    />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rtok.Config/Rtok.Config.csproj" />
    <ProjectReference Include="../Rtok.Core/Rtok.Core.csproj" />
    <ProjectReference Include="../Rtok.Hooks/Rtok.Hooks.csproj" />
    <ProjectReference Include="../Rtok.Process/Rtok.Process.csproj" />
    <ProjectReference Include="../../packages/Pyrlyn.CommandLine.Docs/src/Pyrlyn.CommandLine.Docs.csproj" />
    <ProjectReference Include="../../packages/Pyrlyn.OperationIcons/src/Pyrlyn.OperationIcons.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rtok.Cli.Tests" />
    <!-- The command model (Shell/CommandDocs.cs), kept in step by a drift test. -->
    <EmbeddedResource Include="../../docs/cli/commands.json" LogicalName="commands.json" />
  </ItemGroup>
  <Import Project="../../eng/RtokPlugins.targets" />
</Project>
