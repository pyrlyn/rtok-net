@page "/"

<PageTitle>rtok · Overview</PageTitle>
<RadzenText TextStyle="TextStyle.H4">Overview</RadzenText>

@if (Snapshot is { } snapshot)
{
  var o = snapshot.Overview;
  @foreach (var alert in o.Alerts)
  {
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@alert</RadzenAlert>
  }
  <div class="rtok-kpis rz-mb-4">
    <Kpi Label="Input tokens" Value="@o.Input" />
    <Kpi Label="Output tokens" Value="@o.Output" />
    <Kpi Label="Cache read" Value="@o.CacheRead" />
    <Kpi Label="Cache write" Value="@o.CacheCreate" />
    <Kpi Label="Usage rows" Value="@o.Rows" />
  </div>
  <RadzenText TextStyle="TextStyle.H6">Measured savings</RadzenText>
  @if (o.Savings.Count == 0)
  {
    <RadzenText class="rtok-no-savings">No measurements yet.</RadzenText>
  }
  else
  {
    <RadzenDataGrid TItem="SavingsDay" Data="@o.Savings" Density="Density.Compact" AllowSorting="true">
      <Columns>
        <RadzenDataGridColumn TItem="SavingsDay" Property="@nameof(SavingsDay.Day)" Title="Day" />
        <RadzenDataGridColumn TItem="SavingsDay" Property="@nameof(SavingsDay.Rows)" Title="Measurements" />
        <RadzenDataGridColumn TItem="SavingsDay" Property="@nameof(SavingsDay.Saved)" Title="Tokens saved" />
      </Columns>
    </RadzenDataGrid>
  }
  <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-2">
    updated @snapshot.BuiltAt.ToUniversalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture) UTC
  </RadzenText>
}

@code {
  [CascadingParameter]
  public Snapshot? Snapshot { get; set; }
}
