root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,xml,csproj,props,targets,slnx,yml,yaml,toml}]
indent_size = 2

# The rest of this file is rtok's own; the part above is Pyrlyn.CodeStyle's template.
[*.cs]
# An application, not a library consumed from a UI thread: no SynchronizationContext to
# deadlock on, and the hook client blocks on purpose to stay inside its budget.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.VSTHRD002.severity = none
dotnet_diagnostic.VSTHRD103.severity = none

# Mapperly (T60): a member a mapper leaves out fails the build instead of being dropped.
dotnet_diagnostic.RMG012.severity = error
dotnet_diagnostic.RMG020.severity = error

# EF Core's generated query interceptors (src/Rtok.Store; research.md F): the older
# InterceptsLocation form and EF's own obsolete members. CS8669 is in the project's NoWarn.
[*.EFInterceptors.*.g.cs]
dotnet_diagnostic.CS0184.severity = none
dotnet_diagnostic.CS0618.severity = none
dotnet_diagnostic.CS9270.severity = none
