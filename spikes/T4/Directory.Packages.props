    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <PackageVersion Include="StaticLink.e_sqlite3" Version="2.1.10.1" />
    <PackageVersion Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SourceGear.sqlite3" Version="3.53.3" />
