<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Add a version here with the task that first needs the package (plan/README.md package map). -->
  <ItemGroup>
    <PackageVersion Include="ConsoleAppFramework" Version="5.7.13" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tasks" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageVersion Include="Wcwidth" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.aot.mtp-v2" Version="4.0.2" />
    <PackageVersion Include="Verify.XunitV3" Version="33.3.4" />
    <PackageVersion Include="WireMock.Net" Version="2.19.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Porta.Pty" Version="2.2.3" />
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <PackageVersion Include="Cake.Frosting" Version="6.3.0" />
    <!-- Cake.Frosting brings 10.0.12 (GHSA-846f-f764-76mx); pinned to the patched release. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions" Version="22.3.0" />
    <PackageVersion Include="Testably.Abstractions.Testing" Version="7.1.1" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.3.0" />
    <PackageVersion Include="SharpYaml" Version="3.15.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Radzen.Blazor" Version="12.1.5" />
    <PackageVersion Include="bunit" Version="2.12.5" />
  </ItemGroup>
  <!-- PyrlynCodeStyle marks the analyzers packages/Pyrlyn.CodeStyle depends on. -->
  <ItemGroup>
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" PyrlynCodeStyle="true" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.315" PyrlynCodeStyle="true" />
    <GlobalPackageReference
      Include="Microsoft.VisualStudio.Threading.Analyzers"
      Version="18.7.23"
      PyrlynCodeStyle="true"
    />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
